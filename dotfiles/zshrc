# .zshrc

typeset -U path PATH

# --- Nix ---
# Multi-user (daemon) install, e.g. macOS default and most Linux installs:
if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
# Single-user install fallback:
elif [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
  . "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

# Nix must win over OS built-ins. On macOS, /etc/zprofile's path_helper moves the
# system dirs to the front, and nix-daemon.sh no-ops in child shells (inherited
# __ETC_PROFILE_NIX_SOURCED), so /usr/bin/git etc. would shadow nix. Force the
# order explicitly; typeset -U above drops the later duplicates.
path=("$HOME/.local/bin" "$HOME/.nix-profile/bin" /nix/var/nix/profiles/default/bin $path)

# --- Completion ---
autoload -Uz compinit && compinit -C
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE APPEND_HISTORY

# --- Shared aliases / functions (also used by bash) ---
[ -f ~/.aliases ] && source ~/.aliases
[ -f ~/.functions ] && source ~/.functions

# --- Remote-host marker: set DEVBOX_LABEL on SSH sessions and EC2 boxes (SSM
# sessions don't set SSH_CONNECTION). starship, tmux and the Claude Code
# statusline all key off this to make remote sessions visually distinct.
if [ -z "$DEVBOX_LABEL" ] && { [ -n "$SSH_CONNECTION" ] || grep -qs "Amazon EC2" /sys/devices/virtual/dmi/id/sys_vendor; }; then
  export DEVBOX_LABEL=devbox
fi

# --- Prompt ---
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# --- Proxy / TLS (only kick in on hosts that actually have these, e.g. work/AWS boxes) ---
[ -f /etc/pki/tls/certs/ca-bundle.crt ] && export AWS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
export NO_PROXY="${NO_PROXY:+$NO_PROXY,}s3.amazonaws.com,ec2.amazonaws.com"
export no_proxy="$NO_PROXY"

# --- Remote hosts: land in a persistent tmux session on connect (attach to
# "main" if it exists, else create it). Detaching (C-a d) ends the connection;
# long-running work keeps going in tmux. Skipped inside tmux, for non-tty /
# non-interactive shells, and for shells Claude Code spawns.
# Set NO_AUTO_TMUX=1 to get a plain shell.
if [[ -n $DEVBOX_LABEL && -o interactive && -t 0 && -t 1 && -z $TMUX && -z $CLAUDECODE && -z $NO_AUTO_TMUX ]] \
   && command -v tmux >/dev/null 2>&1; then
  tmux new -A -s main && exit
fi
