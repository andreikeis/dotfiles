# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# --- Nix (in case /etc/bashrc didn't already set this up) ---
if [ -z "$NIX_PROFILES" ]; then
  if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
    . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
  elif [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
    . "$HOME/.nix-profile/etc/profile.d/nix.sh"
  fi
fi

# Nix must win over OS built-ins (see zshrc): move these to the front of PATH,
# dropping any existing occurrence. Lowest priority first.
for _d in /nix/var/nix/profiles/default/bin "$HOME/.nix-profile/bin" "$HOME/.local/bin"; do
  _p=":$PATH:"; _p=${_p//:$_d:/:}; _p=${_p#:}; _p=${_p%:}
  PATH="$_d${_p:+:$_p}"
done
unset _d _p
export PATH

source ~/.git-completion.bash
source ~/.git-prompt.sh

source ~/.aliases
source ~/.functions

# --- Remote-host marker: set DEVBOX_LABEL on SSH sessions and EC2 boxes (SSM
# sessions don't set SSH_CONNECTION). starship, tmux and the Claude Code
# statusline all key off this to make remote sessions visually distinct.
if [ -z "$DEVBOX_LABEL" ] && { [ -n "$SSH_CONNECTION" ] || grep -qs "Amazon EC2" /sys/devices/virtual/dmi/id/sys_vendor; }; then
  export DEVBOX_LABEL=devbox
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
else
  export GIT_PS1_SHOWCOLORHINTS=1
  export GIT_PS1_SHOWDIRTYSTATE=1
  export PS1='\u@\h \w$(__git_ps1 " [%s]") \$ '
fi

# --- Proxy / TLS (only kick in on hosts that actually have these, e.g. work/AWS boxes) ---
[ -f /etc/pki/tls/certs/ca-bundle.crt ] && export AWS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
export NO_PROXY="${NO_PROXY:+$NO_PROXY,}s3.amazonaws.com,ec2.amazonaws.com"
export no_proxy="$NO_PROXY"
